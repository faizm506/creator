# Copy to .env and never commit it. See README for how to generate your own SECRET_KEY.
DEBUG=True
SECRET_KEY=generate-your-own-see-README
ALLOWED_HOSTS=localhost,127.0.0.1,.app.github.dev
# Move the admin to a private address, e.g. ADMIN_URL=studio-ab12cd34ef/
ADMIN_URL=admin/

SITE_NAME=Kyto
# Paid boosting is OFF while the platform is free. Set to True to bring it back later.
BOOST_ENABLED=False
# Number of reverse proxies in front of the app (0 locally, usually 1 on Render/Railway).
TRUSTED_PROXY_COUNT=0

# Only needed when BOOST_ENABLED=True
UPI_ID=yourname@okhdfcbank
UPI_NAME=Your Name
SUPPORT_WHATSAPP=

# Password-reset emails print to the terminal until you add real SMTP settings:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Kyto <no-reply@yourdomain.com>

# ---- Legal details (shown on the Terms, Privacy and Grievance pages). Fill these in before you go live. ----
LEGAL_ENTITY=Zyrac
CONTACT_EMAIL=
GRIEVANCE_NAME=
GRIEVANCE_EMAIL=
GRIEVANCE_PHONE=
GRIEVANCE_ADDRESS=Ahmedabad, Gujarat, India
